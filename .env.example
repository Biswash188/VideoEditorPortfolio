# Server-only. Configure these locally in .env.local and in Vercel Project
# Settings. Never prefix secrets with VITE_ and never commit real values.
DATABASE_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
AUTH_SECRET=

# Optional: used only for lightweight public thumbnail uploads.
BLOB_READ_WRITE_TOKEN=
# VERCEL_BLOB_CALLBACK_URL=https://your-tunnel.example

# Google Drive OAuth, used only by server-side API functions.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Optional; defaults to 5 GiB. Video bytes upload directly from the browser to
# Google Drive, never through Vercel.
MAX_VIDEO_SIZE_BYTES=5368709120
