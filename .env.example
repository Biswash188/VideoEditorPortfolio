# Server-only. Set these in Vercel Project Settings -> Environment Variables.
# Use the pooled or serverless connection string supplied by your Neon integration.
DATABASE_URL=

# The only administrator account. Store only an scrypt hash, not the password.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# At least 32 random characters; signs short-lived HTTP-only administrator sessions.
AUTH_SECRET=

# Server-only Vercel Blob read/write credential. Never prefix this with VITE_ or expose it to the browser.
# Vercel adds this automatically after you connect a Blob store to the project.
BLOB_READ_WRITE_TOKEN=

# Local development only: a public HTTPS tunnel Vercel Blob can use to deliver upload-completion callbacks.
# VERCEL_BLOB_CALLBACK_URL=https://your-tunnel.example
